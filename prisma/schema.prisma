// YFG AI Software Factory — Prisma Schema (71 models)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AiSetting {
  id        String @id @default(cuid())
  key       String @unique
  value     String
  updatedAt DateTime @updatedAt
  @@map("ai_settings")
}

model Prompt {
  id        String @id @default(cuid())
  key       String
  name      String
  content   String
  language  String @default("fa")
  isDefault Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("prompts")
}

model User {
  id           String @id @default(cuid())
  username     String @unique
  email        String? @unique
  passwordHash String
  fullName     String?
  displayName  String?
  isActive     Boolean @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  sessions     UserSession[]
  roles        UserRole[]
  @@map("users")
}

model Role {
  id          String @id @default(cuid())
  name        String @unique
  description String?
  permissions String
  isSystem    Boolean @default(false)
  createdAt   DateTime @default(now())
  users       UserRole[]
  @@map("roles")
}

model UserRole {
  id     String @id @default(cuid())
  userId String
  roleId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

model UserSession {
  id        String @id @default(cuid())
  userId    String
  token     String @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@map("user_sessions")
}

model Workspace {
  id        String @id @default(cuid())
  name      String
  rootPath  String
  language  String?
  framework String?
  status    String @default("active")
  vision    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tasks     Task[]
  artifacts Artifact[]
  traces    TraceLink[]
  audits    AuditLog[]
  @@map("workspaces")
}

model Agent {
  id        String @id @default(cuid())
  name      String @unique
  domain    String
  type      String
  version   String @default("1.0.0")
  config    String?
  enabled   Boolean @default(true)
  createdAt DateTime @default(now())
  tasks     Task[]
  @@map("agents")
}

model Task {
  id            String @id @default(cuid())
  workspaceId   String
  agentId       String?
  parentId      String?
  type          String
  title         String
  input         String?
  output        String?
  status        String @default("pending")
  attempt       Int @default(1)
  maxAttempts   Int @default(3)
  createdAt     DateTime @default(now())
  startedAt     DateTime?
  finishedAt    DateTime?
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agent         Agent? @relation(fields: [agentId], references: [id], onDelete: SetNull)
  artifacts     Artifact[]
  verifications Verification[]
  gates         QualityGate[]
  approvals     Approval[]
  attempts      ReworkAttempt[]
  traces        TraceLink[]
  @@index([workspaceId])
  @@index([status])
  @@map("tasks")
}

model Artifact {
  id            String @id @default(cuid())
  workspaceId   String
  taskId        String
  type          String
  path          String?
  name          String
  content       String
  version       Int @default(1)
  hash          String?
  createdAt     DateTime @default(now())
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  task          Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  verifications Verification[]
  @@index([workspaceId])
  @@index([taskId])
  @@map("artifacts")
}

model Verification {
  id         String @id @default(cuid())
  taskId     String
  artifactId String
  type       String
  result     String @default("pending")
  report     String?
  checkedBy  String?
  createdAt  DateTime @default(now())
  task       Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  artifact   Artifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  gates      QualityGate[]
  @@index([taskId])
  @@index([artifactId])
  @@map("verifications")
}

model QualityGate {
  id             String @id @default(cuid())
  taskId         String
  verificationId String?
  decision       String
  reason         String?
  requiresHuman  Boolean @default(false)
  createdAt      DateTime @default(now())
  task           Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  verification   Verification? @relation(fields: [verificationId], references: [id], onDelete: SetNull)
  @@index([taskId])
  @@map("quality_gates")
}

model Approval {
  id          String @id @default(cuid())
  taskId      String
  gateType    String
  status      String @default("pending")
  decidedBy   String?
  decidedById String?
  comment     String?
  createdAt   DateTime @default(now())
  decidedAt   DateTime?
  task        Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  @@index([taskId])
  @@map("approvals")
}

model ReworkAttempt {
  id        String @id @default(cuid())
  taskId    String
  attempt   Int
  result    String
  feedback  String?
  createdAt DateTime @default(now())
  task      Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  @@index([taskId])
  @@map("rework_attempts")
}

model TraceLink {
  id          String @id @default(cuid())
  workspaceId String
  sourceType  String
  sourceId    String
  targetType  String
  targetId    String
  relation    String
  taskId      String?
  createdAt   DateTime @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  task        Task? @relation(fields: [taskId], references: [id], onDelete: SetNull)
  @@index([workspaceId])
  @@map("trace_links")
}

model AuditLog {
  id          String @id @default(cuid())
  workspaceId String?
  actor       String
  action      String
  targetType  String
  targetId    String
  meta        String?
  hash        String?
  createdAt   DateTime @default(now())
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  @@index([workspaceId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Policy {
  id        String @id @default(cuid())
  name      String @unique
  rule      String
  scope     String
  enabled   Boolean @default(true)
  createdAt DateTime @default(now())
  @@map("policies")
}

model Sandbox {
  id          String @id @default(cuid())
  agentId     String?
  workspaceId String?
  path        String
  status      String @default("idle")
  createdAt   DateTime @default(now())
  @@map("sandboxes")
}

model TaskTemplate {
  id               String @id @default(cuid())
  name             String
  category         String
  description      String
  instruction      String
  agentType        String
  taskType         String
  verificationType String
  approvalGate     String?
  expectedOutput   String?
  icon             String?
  isCustom         Boolean @default(false)
  createdAt        DateTime @default(now())
  @@map("task_templates")
}

model Environment {
  id          String @id @default(cuid())
  workspaceId String
  name        String
  repoPath    String
  branch      String @default("main")
  status      String @default("idle")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  commits     GitCommit[]
  builds      BuildRun[]
  testRuns    TestRun[]
  @@index([workspaceId])
  @@map("environments")
}

model GitCommit {
  id            String @id @default(cuid())
  environmentId String
  sha           String
  message       String
  author        String
  filesChanged  Int @default(0)
  createdAt     DateTime @default(now())
  environment   Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  @@index([environmentId])
  @@map("git_commits")
}

model BuildRun {
  id            String @id @default(cuid())
  environmentId String
  command       String
  success       Boolean
  output        String
  durationMs    Int @default(0)
  createdAt     DateTime @default(now())
  environment   Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  @@index([environmentId])
  @@map("build_runs")
}

model TestRun {
  id            String @id @default(cuid())
  environmentId String
  command       String
  success       Boolean
  passed        Int @default(0)
  failed        Int @default(0)
  output        String
  durationMs    Int @default(0)
  createdAt     DateTime @default(now())
  environment   Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  @@index([environmentId])
  @@map("test_runs")
}

model AgentContract {
  id                String @id @default(cuid())
  agentId           String @unique
  version           String @default("1.0.0")
  capabilities      String
  permissions       String
  tools             String
  maxRetries        Int @default(3)
  canSelfApprove    Boolean @default(false)
  canModifyContract Boolean @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  @@map("agent_contracts")
}

model Capability {
  id          String @id @default(cuid())
  name        String @unique
  description String
  @@map("capabilities")
}

model Permission {
  id          String @id @default(cuid())
  name        String @unique
  description String
  @@map("permissions")
}

model Tool {
  id          String @id @default(cuid())
  name        String @unique
  command     String
  description String
  @@map("tools")
}

model FileIndex {
  id            String @id @default(cuid())
  environmentId String
  path          String
  extension     String
  size          Int @default(0)
  hash          String?
  language      String?
  lineCount     Int @default(0)
  symbolCount   Int @default(0)
  indexedAt     DateTime @default(now())
  symbols       Symbol[]
  @@unique([environmentId, path])
  @@index([environmentId])
  @@map("file_index_p6")
}

model Symbol {
  id       String @id @default(cuid())
  fileId   String
  name     String
  kind     String
  line     Int
  language String
  file     FileIndex @relation(fields: [fileId], references: [id], onDelete: Cascade)
  @@index([fileId])
  @@index([name])
  @@map("symbols_p6")
}

model DependencyEdge {
  id            String @id @default(cuid())
  environmentId String
  sourcePath    String
  targetPath    String
  relation      String @default("imports")
  createdAt     DateTime @default(now())
  @@unique([environmentId, sourcePath, targetPath, relation])
  @@index([environmentId])
  @@map("dependency_edges")
}

model ImpactReport {
  id            String @id @default(cuid())
  environmentId String
  changedPath   String
