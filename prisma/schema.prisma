  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([workspaceId])
  @@map("knowledge_entries")
}

model Notification {
  id        String @id @default(cuid())
  recipient String
  type      String
  title     String
  message   String
  read      Boolean @default(false)
